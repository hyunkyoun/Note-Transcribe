# ---------------------------------------------------------------------------
# Note Transcribe – secrets and API configuration
#
# Copy this file to .env and fill in your values (PowerShell):
#   Copy-Item .env.example .env
#   notepad .env
#
# .env is git-ignored. Never commit it. These values are never written to
# settings.json and never logged.
#
# The app looks for .env in: %APPDATA%\NoteTranscribe\.env, then next to the
# exe and its parent folders (the repo root when using `npm run tauri dev`).
# After editing, click Settings -> "Reload .env" (no restart needed).
# ---------------------------------------------------------------------------

# Anthropic API key for the end-of-meeting summary.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used for the summary.
CLAUDE_MODEL=claude-opus-5-5

# Discord channel webhook (Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Optional Hugging Face token. NOT needed by default: diarization uses
# sherpa-onnx speaker-embedding models downloaded from GitHub, which require no
# account. Only relevant if you swap in a gated model (e.g. pyannote) yourself.
HF_TOKEN=

# ---------------------------- optional tuning ------------------------------
# Max output tokens for the summary (default 16000).
# CLAUDE_MAX_TOKENS=16000

# Reasoning effort: low | medium | high | xhigh | max (default: the model's default).
# CLAUDE_EFFORT=medium

# Transcripts estimated above this many tokens are summarized in chunks and
# then combined (default 150000, safe for every current Claude model).
# CLAUDE_MAX_INPUT_TOKENS=150000

# Server-side refusal fallbacks on models that support them ("off" to disable).
# CLAUDE_FALLBACKS=default

# Use a different prompt file than prompts/summary_prompt.md.
# SUMMARY_PROMPT_PATH=C:\Users\me\Documents\my_summary_prompt.md

# Use a specific speaker-embedding model file (name inside the models folder, or a full path).
# SPEAKER_MODEL=wespeaker_en_voxceleb_resnet34_LM.onnx
